{
  "name": "cortex",
  "private": true,
  "version": "1.2.0",
  "description": "Córtex convierte cualquier repositorio en un grafo de conocimiento vivo que los agentes de IA consultan por MCP, CLI o HTTP, y lo teje como un universo 3D.",
  "author": "Jonathan C (ldikay99)",
  "license": "MIT",
  "homepage": "https://github.com/ldikay99/Cortex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldikay99/Cortex.git"
  },
  "bugs": {
    "url": "https://github.com/ldikay99/Cortex/issues"
  },
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=app.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=app.js --sourcemap --watch --servedir=. --serve=5173",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "playwright-core": "1.64.1"
  }
}
